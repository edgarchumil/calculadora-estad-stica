# Opcional: npm start usa estos valores por defecto sin necesidad de un .env.
# Para cargar un .env local: node --env-file=.env server.js
PORT=3000
APP_ORIGIN=http://localhost:3000
DB_PATH=./data/estadia.sqlite
# En Render, omitir APP_ORIGIN para usar RENDER_EXTERNAL_URL automáticamente.
# Para un dominio propio, APP_ORIGIN debe ser su origen HTTPS sin barra final.
# En Render con disco persistente: DB_PATH=/var/data/estadia.sqlite
